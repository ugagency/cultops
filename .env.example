# Copie para .env e preencha com valores reais. Nunca commitar o .env preenchido.
# Lista de variáveis conferida em server.js (process.env.*) — ver docs/ para o mapa completo
# de onde cada uma é usada (CREDENCIAIS_HANDOFF.md, fora do git, é o handoff de titularidade).

# Supabase (banco, auth, storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Servidor
PORT=3000
NODE_ENV=development

# RPA SALIC (Puppeteer / Browserless)
BROWSERLESS_ENDPOINT=

# OCR de notas fiscais
MISTRAL_API_KEY=

# Envio de e-mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cron jobs internos (rota /api protegida por segredo compartilhado)
CRON_SECRET=

# Deploy (preenchido automaticamente pelas plataformas — normalmente não precisa setar à mão)
RAILWAY_URL=
VERCEL=
DISABLE_FRONTEND=
